PORT=4000
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Exotel India (keep these values on the Node.js server only)
EXOTEL_ACCOUNT_SID=your_account_sid
EXOTEL_API_KEY=your_api_key
EXOTEL_API_TOKEN=your_api_token
EXOTEL_CALLER_ID=your_exophone_number
# Your own verified mobile number; Exotel rings this number first.
EXOTEL_AGENT_NUMBER=+91XXXXXXXXXX
# Public HTTPS URL of your deployed Node API, used for call status callbacks (optional)
PUBLIC_API_URL=https://your-api.example.com
